# Copy to .env and fill in. Never commit real values.

# Database — defaults below match the local Supabase CLI stack (`pnpm supabase start`).
# Production: DATABASE_URL = Supabase pooler (port 6543, ?pgbouncer=true), DIRECT_URL = direct connection.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Optional: integration tests use a separate database on the same server.
# TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/tuanlinh_test"

AUTH_SECRET="your-auth-secret-32-chars-minimum"

# Storage S3 (Supabase Storage / S3 compatible)
STORAGE_ENDPOINT="http://127.0.0.1:54321/storage/v1/s3"
STORAGE_REGION="local"
STORAGE_ACCESS_KEY_ID="625729a08b95bf1b7ff351a663f3a23c"
STORAGE_SECRET_ACCESS_KEY="850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907"
STORAGE_BUCKET="product-images"
STORAGE_PUBLIC_BASE_URL="http://127.0.0.1:54321/storage/v1/object/public/product-images/"
