// Tuấn Linh Coffee — database schema. See SPEC.md "Mô hình dữ liệu".
// Money is always stored as integer VND.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  sortOrder Int       @default(0)
  isVisible Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           String        @id @default(cuid())
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name         String
  description  String        @default("")
  basePrice    Int
  imageKey     String?
  sortOrder    Int           @default(0)
  isAvailable  Boolean       @default(true)
  /// Archived products are hidden instead of hard-deleted once they appear in orders.
  isArchived   Boolean       @default(false)
  optionGroups OptionGroup[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId, sortOrder])
}

model OptionGroup {
  id         String    @id @default(cuid())
  name       String
  isRequired Boolean   @default(false)
  maxSelect  Int       @default(1)
  sortOrder  Int       @default(0)
  options    Option[]
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
}

model Option {
  id         String      @id @default(cuid())
  groupId    String
  group      OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Int         @default(0)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt

  @@index([groupId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  DELIVERING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

model Order {
  id              String               @id @default(cuid())
  code            String               @unique
  status          OrderStatus          @default(PENDING)
  paymentStatus   PaymentStatus        @default(UNPAID)
  paymentMethod   PaymentMethod
  fulfillment     FulfillmentType
  customerName    String
  customerPhone   String
  deliveryAddress String?
  pickupAt        DateTime?
  note            String?
  cancelReason    String?
  subtotal        Int
  shippingFee     Int
  total           Int
  paidAt          DateTime?
  paidById        String?
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([customerPhone])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id              String      @id @default(cuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  productName     String
  productImage    String?
  unitPrice       Int
  quantity        Int
  lineTotal       Int
  selectedOptions Json        @default("[]")
  note            String?

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([orderId])
}

model ShopSettings {
  id                    String   @id @default("default")
  shopName              String   @default("Tuấn Linh Coffee")
  address               String   @default("123 Đường Cà Phê, Quận 1, TP. HCM")
  phone                 String   @default("0987654321")
  openTime              String   @default("07:00")
  closeTime             String   @default("22:00")
  deliveryRadiusKm      Int      @default(5)
  shippingFee           Int      @default(15000)
  freeShippingThreshold Int      @default(150000)
  bankBin               String   @default("970422")
  bankAccountNo         String   @default("0987654321")
  bankAccountName       String   @default("TUAN LINH COFFEE")
  updatedAt             DateTime @updatedAt
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String    @default("Thu Ngân Quầy 1")
  passwordHash   String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
}

